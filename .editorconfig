
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# C#
[*.cs]
indent_style = space
indent_size = 4

# .NET project and configuration files
[*.{csproj,props,targets,proj,vbproj,slnx}]
indent_style = space
indent_size = 2

# JSON and YAML
[*.{json,jsonc,yml,yaml}]
indent_style = space
indent_size = 2

# JavaScript and TypeScript
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_style = space
indent_size = 2

# CSS and preprocessors
[*.{css,scss,less}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Shell scripts
[*.sh]
end_of_line = lf
indent_size = 2

# Windows scripts
[*.{bat,cmd}]
end_of_line = crlf

# Makefile recipes require tabs
[Makefile]
indent_style = tab

# Preserve whitespace in patches
[*.{diff,patch}]
trim_trailing_whitespace = false
